# Supabase (Essenciais para Multi-tenant & Autenticação)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://seu-projeto-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"

# URL da Aplicação (Configurada automaticamente na Vercel ou localhost)
APP_URL="https://seu-app.vercel.app"

# Chave opcional caso utilize recursos de IA generativa
GEMINI_API_KEY=""
